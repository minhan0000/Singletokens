# Copy this file to .env and fill in the values. Never commit .env.

# Postgres connection string from Neon (Dashboard → Connection Details)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Long random string used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Secret used to encrypt users' OpenRouter keys in the database. Exactly 64 hex characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Don't change it later: keys already stored can't be read anymore and users must reconnect.
ENCRYPTION_KEY=

# Port the server listens on (optional, default 3001)
PORT=3001
