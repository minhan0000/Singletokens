# Copy this file to .env and fill in the values. Never commit .env.

# Postgres connection string from Neon (Dashboard → Connection Details)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Long random string used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Port the server listens on (optional, default 3001)
PORT=3001
